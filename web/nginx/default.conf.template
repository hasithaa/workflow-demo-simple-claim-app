# The demo's single entry point (http://localhost:8080): the claims and admin contexts, sign-in, bill storage, and the
# two APIs behind them. Every API and file call is checked against the identity service first, and the signed-in user
# is forwarded as x-user-id / x-user-roles, replacing anything the browser sent.
# INTEGRATION_HOST and IDENTITY_HOST come from docker compose; use host.docker.internal to reach a process on the host.

resolver 127.0.0.11 valid=10s ipv6=off;
client_max_body_size 10m;

server {
    listen 8080;
    root /usr/share/nginx/html;

    set $integration ${INTEGRATION_HOST};
    set $identity ${IDENTITY_HOST};

    # The session check every protected location runs.
    location = /_session {
        internal;
        proxy_pass http://$identity:9095/session;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    # Sign-in, sign-out and the current user.
    location /auth/ {
        proxy_set_header X-Forwarded-Host $host;
        rewrite ^/auth/(.*)$ /$1 break;
        proxy_pass http://$identity:9095;
    }

    # The Claims API built in WSO2 Integrator.
    location /api/claims {
        auth_request /_session;
        auth_request_set $user_id $upstream_http_x_user_id;
        proxy_set_header x-user-id $user_id;
        rewrite ^/api(/claims.*)$ $1 break;
        proxy_pass http://$integration:9090;
    }

    # The Workflow Management API that ships with the workflow runtime; it sees the signed-in user and roles.
    location /api/workflow/ {
        auth_request /_session;
        auth_request_set $user_id $upstream_http_x_user_id;
        auth_request_set $user_roles $upstream_http_x_user_roles;
        proxy_set_header x-user-id $user_id;
        proxy_set_header x-user-roles $user_roles;
        rewrite ^/api(/workflow/.*)$ $1 break;
        proxy_pass http://$integration:8234;
    }

    # Bill storage: the claims context PUTs a file, both contexts read it by its link.
    location /files/ {
        auth_request /_session;
        alias /data/files/;
        dav_methods PUT;
        create_full_put_path on;
        dav_access user:rw group:r all:r;
    }

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-store";
    }
}
